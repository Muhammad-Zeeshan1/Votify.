{
  "name": "Votify — Opinion Arena",
  "short_name": "Votify",
  "description": "Every opinion starts a war. Picture battles, votes, community chatter, XP shop and more.",
  "id": "/",
  "start_url": "./votify.html?source=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "portrait-primary",
  "background_color": "#06070D",
  "theme_color": "#06070D",
  "categories": ["social", "entertainment", "lifestyle", "productivity"],
  "lang": "en",
  "dir": "ltr",
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "any",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "screenshots": [
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Votify battles and voting arena"
    }
  ],
  "shortcuts": [
    {
      "name": "Create Battle",
      "short_name": "Create",
      "description": "Start a new picture battle",
      "url": "./votify.html?view=create&utm_source=pwa_shortcut",
      "icons": [
        {"src": "icon-192.png", "sizes": "192x192"}
      ]
    },
    {
      "name": "Leaderboard",
      "short_name": "Ranks",
      "description": "See top fighters",
      "url": "./votify.html?view=leaderboard&utm_source=pwa_shortcut",
      "icons": [
        {"src": "icon-192.png", "sizes": "192x192"}
      ]
    },
    {
      "name": "Chat",
      "short_name": "Chat",
      "description": "Open community chatter",
      "url": "./votify.html?view=chat&utm_source=pwa_shortcut",
      "icons": [
        {"src": "icon-192.png", "sizes": "192x192"}
      ]
    },
    {
      "name": "Daily Spin",
      "short_name": "Spin",
      "description": "Free daily XP spin",
      "url": "./votify.html?view=tools&tool=spin&utm_source=pwa_shortcut",
      "icons": [
        {"src": "icon-192.png", "sizes": "192x192"}
      ]
    }
  ],
  "share_target": {
    "action": "./votify.html?view=create",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "image",
          "accept": ["image/png", "image/jpeg", "image/webp", "image/gif"]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./votify.html?view=create",
      "accept": {
        "image/png": [".png"],
        "image/jpeg": [".jpg", ".jpeg"],
        "image/webp": [".webp"]
      },
      "icons": [
        {"src": "icon-192.png", "sizes": "192x192"}
      ]
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+votify",
      "url": "./votify.html?view=battle&id=%s"
    }
  ],
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "edge_side_panel": {
    "preferred_width": 400
  }
}
